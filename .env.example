# ==============================================================================
# ARES — Smart Retrofit Monitoring & Optimization Platform
# Environment Configuration Template (.env.example)
#
# INSTRUCTIONS:
# 1. Copy this file to '.env':
#      cp .env.example .env
# 2. Fill in the required placeholders below. NEVER commit your '.env' file.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
# Username for PostgreSQL database
POSTGRES_USER=ares_user

# REQUIRED: Strong password for the database.
# NOTE: If your password contains special characters (e.g. '@', '#', ':', '/', '%'),
# they MUST be URL-encoded (percent-encoded) when written into DATABASE_URL.
# Example: '@' becomes '%40', '#' becomes '%23'.
# Alternatively, generate a strong alphanumeric password:
#   openssl rand -base64 24 | tr -dc 'a-zA-Z0-9' | head -c 24
POSTGRES_PASSWORD=replace_with_strong_database_password

# Database name
POSTGRES_DB=ares_db

# DATABASE_URL:
# ------------------------------------------------------------------------------
# Case A — Running via Docker Compose:
#   Leave DATABASE_URL commented out below, OR explicitly set it targeting the
#   Compose service hostname 'db':
#   DATABASE_URL=postgresql://ares_user:replace_with_strong_database_password@db:5432/ares_db
#
# Case B — Running FastAPI directly on your host machine (outside Docker):
#   Point to 'localhost' where PostgreSQL port 5432 is exposed:
DATABASE_URL=postgresql://ares_user:replace_with_strong_database_password@localhost:5432/ares_db


# ------------------------------------------------------------------------------
# 2. Security & Authentication (JWT)
# ------------------------------------------------------------------------------
# REQUIRED: Cryptographically secure 256-bit random key for signing JWT tokens.
# Docker Compose will refuse to start if this is unset or left with fallback values.
#
# To generate a new secure secret key, run one of the following commands:
#   openssl rand -hex 32
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_generated_256bit_hex_secret_key

# JWT signing algorithm (default: HS256)
ALGORITHM=HS256

# Token expiration lifetimes
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7


# ------------------------------------------------------------------------------
# 3. Application & Server Settings
# ------------------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
MAX_UPLOAD_SIZE_MB=10

# Comma-separated list of allowed CORS origins for the API
CORS_ORIGINS=http://localhost:5173,http://localhost:3000


# ------------------------------------------------------------------------------
# 4. Frontend Client Settings
# ------------------------------------------------------------------------------
# Base URL of the FastAPI backend for Axios HTTP calls
VITE_API_URL=http://localhost:8000

# Base URL of the WebSocket endpoint for real-time sensor & alert streams
VITE_WS_URL=ws://localhost:8000
